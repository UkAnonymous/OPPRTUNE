<% layout("/layouts/boilerplate") %>
<body>
  <h3>All Available jobs</h3>

  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
    <% for (let listing of allListings) { %>
    <div class="card col" style="width: 20rem;">
      <img src="<%= listing.imageURL %>" class="card-img-top" alt="listing_image" height="180rem" />
      <div class="class-img-overlay"></div>
      <div class="card-body">
        <b>
          <p class="card-text"><%= listing.title %></p>
        </b>
        <p><%= listing.description %></p>
        <p><%= listing.company %></p>
        <p><%= listing.location %></p>
        <a href="<%= listing.URL %>">
          <button>Apply</button>
        </a>
      </div>
    </div>
    <% } %>
  </div>
</body>