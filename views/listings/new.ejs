<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3> Create a new Listing</h3>
    <form method="post" action="/listings">
        <input name="listing[title]" placeholder="Enter the title" type="text">
        <br /> <br />
        <textarea name="listing[description]" placeholder="Enter description"></textarea>
        <br/><br />
        <input name="listing[company]" placeholder="Enter company name " type="text">
        <br/><br />
        <input name="listing[location]" placeholder="Enter location" type="text">
        <br/><br />
        <input name="listing[imageURL]" placeholder="Enter the image URL/Link" type="text">
        <br/><br />
        <input name="listing[URL]" placeholder="Enter the apply URL/Link" type="text">
        <br/><br />
        <button>Add</button>
    </form>
</body>
</html>